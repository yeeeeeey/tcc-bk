{
  {
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "backend"
    },
    {
      "source": "/:path*",
      "destination": "frontend"
    }
  ]
}
