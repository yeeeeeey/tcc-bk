# Copie para ".env" na raiz do repositório (o .env NÃO vai para o Git).
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Banco PostgreSQL (Neon: painel > Connection Details). Obrigatória.
DATABASE_URL=postgresql://usuario:senha@host/nome_do_banco?sslmode=require

# TLS do banco: o certificado do servidor é sempre verificado.
# DATABASE_SSL=false        -> só para um Postgres LOCAL sem SSL
# DATABASE_CA_CERT=...      -> certificado (PEM) da CA, se o provedor usar CA própria

# Só se o site ficar em OUTRO domínio que a API (lista separada por vírgula).
# Em produção, sem esta variável, nenhuma origem externa é aceita.
# FRONTEND_URL=https://meu-site.com

# Duração da sessão de login, em horas (padrão 8)
# SESSAO_HORAS=8

# Banco usado SOMENTE pelos testes automatizados ("npm test").
# ATENÇÃO: os testes apagam e recriam todas as tabelas desse banco.
# TEST_DATABASE_URL=postgresql://usuario:senha@localhost:5432/bankai_teste
