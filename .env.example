# Copie para .env (nesta mesma pasta, a raiz do repositório) e preencha.
# O .env nunca vai para o Git. Na Vercel, cadastre as mesmas variáveis em
# Settings > Environment Variables.

# String de conexão da Neon (painel > Connect > Connection string)
DATABASE_URL=postgresql://usuario:senha@host/nome_do_banco?sslmode=require

# Use false só para um Postgres local sem SSL
DATABASE_SSL=true

# Porta do backend local (a Vercel ignora)
PORT=3000

# Origem(ns) do front liberadas no CORS, separadas por vírgula.
# Deixe vazio em desenvolvimento e na Vercel (lá o front e a API ficam no mesmo domínio).
FRONTEND_URL=
